#!/usr/bin/env python3
"""Send TeraStation alerts (smartd, mdadm, cron) via Telegram Bot API."""

import json
import os
import socket
import sys
import urllib.request

CONF_PATH = "/etc/terastation-notify.conf"
MDADM_EVENTS = {
    "DegradedArray",
    "DeviceDisappeared",
    "Fail",
    "FailSpare",
    "MoveSpare",
    "NewArray",
    "Rebuild20",
    "Rebuild40",
    "Rebuild60",
    "Rebuild80",
    "RebuildFinished",
    "RebuildStarted",
    "SpareActive",
    "SparesMissing",
    "TestMessage",
}


def load_config(path: str) -> tuple[str, str]:
    """Load TELEGRAM_BOT_TOKEN and TELEGRAM_CHAT_ID from config file."""
    if not os.path.isfile(path):
        return "", ""
    cfg: dict[str, str] = {}
    with open(path, "r", encoding="utf-8") as f:
        for line in f:
            line = line.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            k, v = line.split("=", 1)
            cfg[k.strip()] = v.strip().strip('"').strip("'")
    return cfg.get("TELEGRAM_BOT_TOKEN", ""), cfg.get("TELEGRAM_CHAT_ID", "")


def send_telegram(token: str, chat_id: str, text: str) -> None:
    """Send a Telegram message forcing IPv4 to avoid IPv6 timeout."""
    orig_getaddrinfo = socket.getaddrinfo
    socket.getaddrinfo = (
        lambda host, port, family=0, *args, **kwargs: orig_getaddrinfo(
            host, port, socket.AF_INET, *args, **kwargs
        )
    )
    url = f"https://api.telegram.org/bot{token}/sendMessage"
    payload = json.dumps({"chat_id": chat_id, "text": text}).encode("utf-8")
    req = urllib.request.Request(
        url, data=payload, headers={"Content-Type": "application/json"}
    )
    with urllib.request.urlopen(req, timeout=15) as resp:
        resp.read()


def format_message(args: list[str]) -> str:
    """Format CLI arguments (manual message or mdadm PROGRAM args)."""
    if not args:
        return "Alert triggered (no details)"
    if args[0] in MDADM_EVENTS:
        event = args[0]
        array = args[1] if len(args) > 1 else ""
        device = args[2] if len(args) > 2 else ""
        details = " ".join(p for p in (array, device) if p)
        return f"RAID {event}: {details}".strip()
    return " ".join(args)


def main() -> int:
    token, chat_id = load_config(CONF_PATH)
    if not token or not chat_id:
        return 0
    msg = format_message(sys.argv[1:])
    try:
        send_telegram(token, chat_id, msg)
    except Exception as exc:
        print(f"nas-notify error: {exc}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
