#!/usr/bin/env bash
# ==============================================================================
# TeraStation TS5800D - Disk Replacement and Rebuild Assistant
# Designed for safe, assisted operations in hardware failure scenarios
# Supports:
#   - rebuild <device>         : Replaces and rebuilds 1 failed disk
#   - rebuild --init-storage   : Disaster recovery (recreates 18 TB ZFS from scratch)
#
# For read-only health diagnostics and disk mapping, run: status
# ==============================================================================

set -o pipefail
export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:$PATH"

# ANSI Colors
RED='\033[1;31m'
GREEN='\033[1;32m'
YELLOW='\033[1;33m'
CYAN='\033[1;36m'
BOLD='\033[1m'
NC='\033[0m' # No Color

# Auto-elevate to sudo if executed as standard user
if [ "$(id -u)" -ne 0 ]; then
    exec sudo "$0" "$@"
fi

POOL_NAME="storage"

# Auto-detect number of physical ATA ports on chassis (2, 4, 6 or 8 bays)
TOTAL_BAYS=$(ls -d /sys/class/ata_port/ata* 2>/dev/null | wc -l)
if [ -z "$TOTAL_BAYS" ] || [ "$TOTAL_BAYS" -le 0 ]; then
    TOTAL_BAYS=8
fi

declare -A DISK_MAP
DISK_MAP["pci-0000:00:1f.2-ata-1"]="Disk 1"
DISK_MAP["pci-0000:00:1f.2-ata-2"]="Disk 2"
DISK_MAP["pci-0000:00:1f.2-ata-3"]="Disk 3"
DISK_MAP["pci-0000:00:1f.2-ata-4"]="Disk 4"
DISK_MAP["pci-0000:00:1f.2-ata-5"]="Disk 5"
DISK_MAP["pci-0000:00:1f.2-ata-6"]="Disk 6"
DISK_MAP["pci-0000:01:00.0-ata-1"]="Disk 7"
DISK_MAP["pci-0000:01:00.0-ata-2"]="Disk 8"

all_bays=(
    "pci-0000:00:1f.2-ata-1"
    "pci-0000:00:1f.2-ata-2"
    "pci-0000:00:1f.2-ata-3"
    "pci-0000:00:1f.2-ata-4"
    "pci-0000:00:1f.2-ata-5"
    "pci-0000:00:1f.2-ata-6"
    "pci-0000:01:00.0-ata-1"
    "pci-0000:01:00.0-ata-2"
)

sorted_bays=("${all_bays[@]:0:$TOTAL_BAYS}")

get_disk_for_dev() {
    local target="$1"
    target=$(basename "$target")
    for p in "${!DISK_MAP[@]}"; do
        local link_path="/dev/disk/by-path/$p"
        if [ -L "$link_path" ]; then
            local dest
            dest=$(basename "$(readlink -f "$link_path")")
            if [ "$dest" == "$target" ]; then
                echo "${DISK_MAP[$p]}"
                return
            fi
        fi
    done
    echo "Unknown"
}

init_storage() {
    echo -e "${RED}================================================================================${NC}"
    echo -e "${BOLD}       WARNING: COMPLETE ZFS POOL & iSCSI VOLUME (18 TB) INITIALIZATION         ${NC}"
    echo -e "${RED}================================================================================${NC}"
    echo -e "This procedure is intended for ${BOLD}DISASTER RECOVERY${NC} (loss of 2+ disks),"
    echo -e "where the ZFS pool was lost and replacement disks have been inserted."
    echo ""
    echo -e "${YELLOW}WHAT THIS PROCEDURE WILL DO:${NC}"
    echo -e "  1. Verify physical presence of all 8 disks in the slots."
    echo -e "  2. Partition new/raw disks and align GPT partitions."
    echo -e "  3. Synchronize Debian RAID (md0 and md1) across all 8 disks."
    echo -e "  4. Install GRUB bootloader on all 8 disks."
    echo -e "  5. Recreate ZFS pool '$POOL_NAME' in RAID-Z1 (ashift=12) with all 8 disks."
    echo -e "  6. Recreate iSCSI volume '$POOL_NAME/lun0' (18 TB, 64K, sync=disabled)."
    echo -e "  7. Restart kernel iSCSI target service (LIO)."
    echo -e "${RED}--------------------------------------------------------------------------------${NC}"
    echo -e "${RED}${BOLD}DANGER:${NC} All data on the ZFS pool will be ${BOLD}ERASED${NC} and the volume recreated empty."
    echo -e "To confirm, type ${BOLD}INITIALIZE${NC} (in uppercase):"
    read -p "Confirmation: " CONFIRM_INIT

    if [[ "$CONFIRM_INIT" != "INITIALIZE" && "$CONFIRM_INIT" != "INICIALIZAR" ]]; then
        echo -e "${YELLOW}Operation cancelled by user.${NC}"
        exit 0
    fi

    echo ""
    echo -e "${CYAN}[1/5] Verifying physical presence of all 8 disks...${NC}"
    local zfs_vdevs=()
    local missing_disks=()
    local donor_disk=""

    for p in "${sorted_bays[@]}"; do
        local disk_label="${DISK_MAP[$p]}"
        local link_path="/dev/disk/by-path/$p"
        if [ ! -L "$link_path" ]; then
            missing_disks+=("$disk_label")
        else
            local dev_name
            dev_name=$(basename "$(readlink -f "$link_path")")
            zfs_vdevs+=("${dev_name}4")
            if [ -z "$donor_disk" ] && [ -b "/dev/${dev_name}1" ] && [ -b "/dev/${dev_name}2" ] && [ -b "/dev/${dev_name}3" ] && [ -b "/dev/${dev_name}4" ]; then
                donor_disk="/dev/$dev_name"
            fi
        fi
    done

    if [ ${#missing_disks[@]} -gt 0 ]; then
        echo -e "${RED}[CRITICAL ERROR] The following slots are empty: ${missing_disks[*]}${NC}"
        echo -e "All 8 disks must be inserted before running --init-storage."
        exit 1
    fi
    echo -e "${GREEN}  -> [OK] All 8 disks are present in their slots.${NC}"

    if [ -z "$donor_disk" ]; then
        echo -e "${RED}[CRITICAL ERROR] No disk with valid partition table found to use as template!${NC}"
        exit 1
    fi

    echo -e "\n${CYAN}[2/5] Checking partitions, Debian mirror and bootloader on all 8 disks...${NC}"
    for p in "${sorted_bays[@]}"; do
        local dev_name
        dev_name=$(basename "$(readlink -f "/dev/disk/by-path/$p")")
        local dev_path="/dev/$dev_name"

        if [ ! -b "${dev_path}1" ] || [ ! -b "${dev_path}2" ] || [ ! -b "${dev_path}3" ] || [ ! -b "${dev_path}4" ]; then
            echo -e "  Cloning partition table to $dev_path (template: $donor_disk)..."
            sfdisk -d "$donor_disk" | sfdisk --force "$dev_path" >/dev/null 2>&1
            sgdisk -G "$dev_path" >/dev/null 2>&1
            blockdev --rereadpt "$dev_path" 2>/dev/null || true
            udevadm settle
            sleep 1
        fi

        if ! grep -q "${dev_name}2" /proc/mdstat; then
            mdadm --manage /dev/md0 --add "${dev_path}2" >/dev/null 2>&1 || true
        fi
        if ! grep -q "${dev_name}3" /proc/mdstat; then
            mdadm --manage /dev/md1 --add "${dev_path}3" >/dev/null 2>&1 || true
        fi
        grub-install "$dev_path" >/dev/null 2>&1 || true
    done
    echo -e "${GREEN}  -> [OK] Debian Operating System mirror and GRUB bootloader verified on all disks.${NC}"

    echo -e "\n${CYAN}[3/5] Recreating ZFS pool '$POOL_NAME' in RAID-Z1...${NC}"
    systemctl stop rtslib-fb-targetctl 2>/dev/null || true
    zpool destroy -f "$POOL_NAME" 2>/dev/null || true
    zpool create -f -o ashift=12 "$POOL_NAME" raidz1 "${zfs_vdevs[@]}"
    echo -e "${GREEN}  -> [OK] ZFS pool '$POOL_NAME' recreated successfully.${NC}"

    echo -e "\n${CYAN}[4/5] Creating 18 TB iSCSI volume (64K, sync=disabled)...${NC}"
    zfs create -V 18T -b 64K -o sync=disabled -o compression=off "$POOL_NAME/lun0"
    udevadm settle
    sleep 2
    echo -e "${GREEN}  -> [OK] Volume '$POOL_NAME/lun0' created successfully.${NC}"

    echo -e "\n${CYAN}[5/5] Reactivating iSCSI storage target service (LIO)...${NC}"
    systemctl restart rtslib-fb-targetctl
    echo -e "${GREEN}  -> [OK] iSCSI target online and pointing to the new volume.${NC}"

    echo -e "\n${CYAN}================================================================================${NC}"
    echo -e "${GREEN}${BOLD}     STORAGE INITIALIZED SUCCESSFULLY! NEW 18 TB VOLUME READY                   ${NC}"
    echo -e "${CYAN}==============================================================================${NC}"
    echo -e "Next steps on Windows:"
    echo -e "  1. Open Disk Management (diskmgmt.msc)."
    echo -e "  2. Initialize disk in GPT and format as quick NTFS (Drive G:)."
    echo -e "  3. Run your restore script: Restore_PC.cmd."
    echo -e "${CYAN}==============================================================================${NC}"
    exit 0
}

# Shortcut if user types 'rebuild status'
if [ "$1" == "status" ]; then
    exec status
fi

# Disaster recovery parameter
if [ "$1" == "--init-storage" ]; then
    init_storage
fi

# Helper: Auto-detect any failed disk on the system
AUTO_FAILED_DEV=""
AUTO_FAILED_DISK=""
mdstat_now=$(cat /proc/mdstat 2>/dev/null)
zfs_now=$(/sbin/zpool status "$POOL_NAME" 2>/dev/null)

for p in "${sorted_bays[@]}"; do
    d_label="${DISK_MAP[$p]}"
    l_path="/dev/disk/by-path/$p"
    if [ -L "$l_path" ]; then
        d_name=$(basename "$(readlink -f "$l_path")")
        d_path="/dev/$d_name"
        d_failed=0
        if [ ! -b "${d_path}1" ] || [ ! -b "${d_path}2" ] || [ ! -b "${d_path}3" ] || [ ! -b "${d_path}4" ]; then
            d_failed=1
        elif ! grep -q -E "(^|[[:space:]])${d_name}2\[[0-9]+\]([[:space:]]|$)" <<< "$mdstat_now"; then
            d_failed=1
        elif ! grep -q -E "(^|[[:space:]])${d_name}3\[[0-9]+\]([[:space:]]|$)" <<< "$mdstat_now"; then
            d_failed=1
        elif grep -q -E "^[[:space:]]+${d_name}4[[:space:]]+(FAULTED|DEGRADED|UNAVAIL|OFFLINE|REMOVED)" <<< "$zfs_now"; then
            d_failed=1
        elif grep -q -E "was .*/${d_name}4(/old)?([[:space:]]|$)" <<< "$zfs_now"; then
            d_failed=1
        elif grep -q -E "^[[:space:]]+${d_name}4[[:space:]]+ONLINE.*\(resilvering\)" <<< "$zfs_now"; then
            d_failed=1
        elif ! grep -q -E "^[[:space:]]+${d_name}4[[:space:]]" <<< "$zfs_now"; then
            d_failed=1
        fi
        if [ "$d_failed" -eq 1 ] && [ -z "$AUTO_FAILED_DEV" ]; then
            AUTO_FAILED_DEV="$d_path"
            AUTO_FAILED_DISK="$d_label"
        fi
    fi
done

# If called without parameters, check if a single disk failed and auto-select
if [ $# -eq 0 ]; then
    if [ -n "$AUTO_FAILED_DEV" ]; then
        echo -e "${YELLOW}Auto-detected failed disk: ${BOLD}$AUTO_FAILED_DISK${NC}"
        TARGET_DEV="$AUTO_FAILED_DEV"
    else
        echo -e "${CYAN}==============================================================================${NC}"
        echo -e "${BOLD}       TeraStation TS5800D - Disk Replacement & Rebuild Tool                    ${NC}"
        echo -e "${CYAN}==============================================================================${NC}"
        echo -e "Usage:"
        echo -e "  ${BOLD}rebuild${NC}                  Auto-detect and rebuild the failed disk"
        echo -e "  ${BOLD}rebuild <1-8>${NC}            Rebuild by physical bay number (e.g. ${GREEN}rebuild 1${NC})"
        echo -e "  ${BOLD}rebuild <device>${NC}         Rebuild by device name (e.g. ${GREEN}rebuild /dev/sdb${NC})"
        echo -e "  ${BOLD}rebuild --init-storage${NC}   Disaster recovery (recreates 18 TB ZFS pool and iSCSI target)"
        echo -e ""
        echo -e "To view current disk map and health diagnostics, run: ${GREEN}${BOLD}status${NC}"
        echo -e "${CYAN}==============================================================================${NC}"
        exit 0
    fi
elif [ "$1" == "-h" ] || [ "$1" == "--help" ]; then
    echo -e "Usage: rebuild [1-8 | /dev/sdX | --init-storage]"
    exit 0
else
    # Parse parameter: support physical bay number (1-8, Disk 1) or device path (/dev/sdb)
    case "$1" in
        1|[dD]1|[dD][iI][sS][kK]1|"Disk 1"|"disk 1") p_bay="pci-0000:00:1f.2-ata-1" ;;
        2|[dD]2|[dD][iI][sS][kK]2|"Disk 2"|"disk 2") p_bay="pci-0000:00:1f.2-ata-2" ;;
        3|[dD]3|[dD][iI][sS][kK]3|"Disk 3"|"disk 3") p_bay="pci-0000:00:1f.2-ata-3" ;;
        4|[dD]4|[dD][iI][sS][kK]4|"Disk 4"|"disk 4") p_bay="pci-0000:00:1f.2-ata-4" ;;
        5|[dD]5|[dD][iI][sS][kK]5|"Disk 5"|"disk 5") p_bay="pci-0000:00:1f.2-ata-5" ;;
        6|[dD]6|[dD][iI][sS][kK]6|"Disk 6"|"disk 6") p_bay="pci-0000:00:1f.2-ata-6" ;;
        7|[dD]7|[dD][iI][sS][kK]7|"Disk 7"|"disk 7") p_bay="pci-0000:01:00.0-ata-1" ;;
        8|[dD]8|[dD][iI][sS][kK]8|"Disk 8"|"disk 8") p_bay="pci-0000:01:00.0-ata-2" ;;
        *) p_bay="" ;;
    esac

    if [ -n "$p_bay" ]; then
        if [ -L "/dev/disk/by-path/$p_bay" ]; then
            TARGET_DEV=$(readlink -f "/dev/disk/by-path/$p_bay")
        else
            echo -e "${RED}[ERROR] Physical bay for Disk $1 is empty or disconnected!${NC}"
            exit 1
        fi
    else
        INPUT_DEV="$1"
        CLEAN_DEV="${INPUT_DEV#/dev/}"       # remove /dev/ prefix if provided
        CLEAN_DEV="${CLEAN_DEV%%[0-9]*}"    # remove partition number if provided e.g. sdd4
        TARGET_DEV="/dev/$CLEAN_DEV"
    fi

    if [ ! -b "$TARGET_DEV" ]; then
        echo -e "${RED}[ERROR] Device $TARGET_DEV does not exist on the system!${NC}"
        echo -e "Check if the tray is properly seated or type ${BOLD}status${NC} to view active disks."
        exit 1
    fi

fi

CLEAN_DEV=$(basename "$TARGET_DEV")

TARGET_DISK=$(get_disk_for_dev "$TARGET_DEV")
TARGET_SIZE=$(lsblk -d -n -o SIZE "$TARGET_DEV" 2>/dev/null || echo "N/A")
TARGET_MODEL=$(lsblk -d -n -o MODEL "$TARGET_DEV" 2>/dev/null || echo "N/A")
TARGET_SERIAL=$(lsblk -d -n -o SERIAL "$TARGET_DEV" 2>/dev/null || echo "N/A")

# Safeguard: refuse to wipe a disk that is already rebuilding or 100% healthy in all arrays
mdstat_check=$(cat /proc/mdstat 2>/dev/null || true)
zfs_check=$(/sbin/zpool status "$POOL_NAME" 2>/dev/null || true)
if grep -q -E "^[[:space:]]+${CLEAN_DEV}4[[:space:]]+ONLINE.*\(resilvering\)" <<< "$zfs_check"; then
    echo -e "\n${YELLOW}[SAFEGUARD] $TARGET_DISK ($TARGET_DEV) is currently REBUILDING (ZFS resilvering in progress).${NC}"
    echo -e "Refusing to wipe an active rebuild. Run ${BOLD}status${NC} to monitor progress."
    exit 1
fi
if grep -q -E "(^|[[:space:]])${CLEAN_DEV}2\[[0-9]+\]([[:space:]]|$)" <<< "$mdstat_check" && \
   grep -q -E "(^|[[:space:]])${CLEAN_DEV}3\[[0-9]+\]([[:space:]]|$)" <<< "$mdstat_check" && \
   grep -q -E "^[[:space:]]+${CLEAN_DEV}4[[:space:]]+ONLINE([[:space:]]+[0-9]+){3}[[:space:]]*$" <<< "$zfs_check" && \
   ! grep -q -E "^[[:space:]]+${CLEAN_DEV}4[[:space:]]+(FAULTED|DEGRADED|UNAVAIL|OFFLINE|REMOVED)" <<< "$zfs_check" && \
   ! grep -q -E "was .*/${CLEAN_DEV}4(/old)?([[:space:]]|$)" <<< "$zfs_check"; then
    echo -e "\n${GREEN}[SAFEGUARD] $TARGET_DISK ($TARGET_DEV) is already 100% ONLINE and synchronized in md0, md1, and ZFS.${NC}"
    echo -e "Refusing to wipe a healthy disk. Run ${BOLD}status${NC} to identify the actual failed bay."
    exit 1
fi

echo -e "\n${CYAN}==========================================================${NC}"
echo -e "${YELLOW}${BOLD}              WARNING - DISK REBUILD PROCESS              ${NC}"
echo -e "${CYAN}==========================================================${NC}"
echo -e "  Target Disk : ${BOLD}$TARGET_DISK${NC}"
echo -e "  Model       : $TARGET_MODEL"
echo -e "  Serial      : $TARGET_SERIAL"
echo -e "  Size        : $TARGET_SIZE"

# Locate a healthy active donor disk to clone partition table from
SOURCE_DISK=""
for d in sda sdb sdc sdd sde sdf sdg sdh; do
    if [ "$d" != "$CLEAN_DEV" ] && [ -b "/dev/$d" ]; then
        if [ -b "/dev/${d}1" ] && [ -b "/dev/${d}2" ] && [ -b "/dev/${d}3" ] && [ -b "/dev/${d}4" ]; then
            if [ -z "$mdstat_check" ] || grep -q "${d}2\[" <<< "$mdstat_check"; then
                SOURCE_DISK="/dev/$d"
                break
            fi
        fi
    fi
done

if [ -z "$SOURCE_DISK" ]; then
    echo -e "${RED}[CRITICAL ERROR] Could not find a healthy reference disk to clone partitions!${NC}"
    exit 1
fi

echo -e "${CYAN}==========================================================${NC}"
echo -e "${YELLOW}All current data on ${RED}${BOLD}$TARGET_DISK${NC}${YELLOW} will be completely erased.${NC}"
read -p "Do you want to proceed with rebuilding $TARGET_DISK? [y/N]: " CONFIRM
CONFIRM=$(echo "$CONFIRM" | tr '[:upper:]' '[:lower:]')

if [[ "$CONFIRM" != "y" && "$CONFIRM" != "yes" && "$CONFIRM" != "s" && "$CONFIRM" != "sim" ]]; then
    echo -e "${YELLOW}Operation cancelled by user.${NC}"
    exit 0
fi

echo ""
SPINNER_PID=""
STEP_PREFIX=""

stop_spinner() {
    if [ -n "$SPINNER_PID" ]; then
        kill "$SPINNER_PID" >/dev/null 2>&1 || true
        wait "$SPINNER_PID" >/dev/null 2>&1 || true
        SPINNER_PID=""
    fi
}
trap stop_spinner EXIT INT TERM

step_start() {
    local msg="$1"
    local pad=$((69 - ${#msg}))
    [ "$pad" -lt 3 ] && pad=3
    local dots
    dots=$(printf '%*s' "$pad" '' | tr ' ' '.')
    STEP_PREFIX="${msg} ${dots} "

    stop_spinner
    if [ -t 1 ]; then
        printf "\r%s[ ${CYAN}||${NC} ]" "$STEP_PREFIX"
        (
            local frames=('||' '//' '--' '\\')
            local i=0
            while true; do
                printf "\r%s[ ${CYAN}%s${NC} ]" "$STEP_PREFIX" "${frames[$i]}"
                i=$(( (i + 1) % 4 ))
                sleep 0.15
            done
        ) &
        SPINNER_PID=$!
    else
        printf "%s" "$STEP_PREFIX"
    fi
}

step_ok() {
    stop_spinner
    if [ -t 1 ]; then
        printf "\r%s[ ${GREEN}OK${NC} ]\n" "$STEP_PREFIX"
    else
        echo -e "[ ${GREEN}OK${NC} ]"
    fi
}

step_fail() {
    stop_spinner
    if [ -t 1 ]; then
        printf "\r%s[${RED}FAIL${NC}]\n" "$STEP_PREFIX"
    else
        echo -e "[${RED}FAIL${NC}]"
    fi
    [ -n "${1:-}" ] && echo -e "${RED}  $1${NC}"
    exit 1
}

# ------------------------------------------------------------------------------
# Step 1: Wipe residual metadata and clone GPT partition table
# ------------------------------------------------------------------------------
step_start "[1/5] Partition table (${TARGET_DEV} from ${SOURCE_DISK})"
for part in "${TARGET_DEV}"[0-9]*; do
    if [ -b "$part" ]; then
        mdadm --manage /dev/md0 --fail "$part" >/dev/null 2>&1 || true
        mdadm --manage /dev/md0 --remove "$part" >/dev/null 2>&1 || true
        mdadm --manage /dev/md1 --fail "$part" >/dev/null 2>&1 || true
        mdadm --manage /dev/md1 --remove "$part" >/dev/null 2>&1 || true
        zpool labelclear -f "$part" >/dev/null 2>&1 || true
        mdadm --zero-superblock "$part" >/dev/null 2>&1 || true
        wipefs -a "$part" >/dev/null 2>&1 || true
    fi
done
zpool labelclear -f "$TARGET_DEV" >/dev/null 2>&1 || true
mdadm --zero-superblock "$TARGET_DEV" >/dev/null 2>&1 || true
wipefs -a "$TARGET_DEV" >/dev/null 2>&1 || true
sgdisk --zap-all "$TARGET_DEV" >/dev/null 2>&1 || true

sfdisk -d "$SOURCE_DISK" | sfdisk --force "$TARGET_DEV" >/dev/null 2>&1
sgdisk -G "$TARGET_DEV" >/dev/null 2>&1
blockdev --rereadpt "$TARGET_DEV" 2>/dev/null || true
udevadm settle
sleep 2

if [ ! -b "${TARGET_DEV}2" ] || [ ! -b "${TARGET_DEV}4" ]; then
    step_fail "Failed to verify partitions on $TARGET_DEV!"
fi

# Clear any stale RAID/ZFS superblocks aligned with the newly created partitions
for pnum in 2 3 4; do
    zpool labelclear -f "${TARGET_DEV}${pnum}" >/dev/null 2>&1 || true
    mdadm --zero-superblock "${TARGET_DEV}${pnum}" >/dev/null 2>&1 || true
    wipefs -a "${TARGET_DEV}${pnum}" >/dev/null 2>&1 || true
done
step_ok

# ------------------------------------------------------------------------------
# Step 2: Re-add Root partition (Debian OS /) to RAID-1 md0
# ------------------------------------------------------------------------------
step_start "[2/5] System RAID-1 mirror (md0 <- ${TARGET_DEV}2)"
mdadm --manage /dev/md0 --add "${TARGET_DEV}2" >/dev/null 2>&1 || true
step_ok

# ------------------------------------------------------------------------------
# Step 3: Re-add Swap partition to RAID-1 md1
# ------------------------------------------------------------------------------
step_start "[3/5] Swap RAID-1 mirror (md1 <- ${TARGET_DEV}3)"
mdadm --manage /dev/md1 --add "${TARGET_DEV}3" >/dev/null 2>&1 || true
mdadm --readwrite /dev/md0 >/dev/null 2>&1 || true
mdadm --readwrite /dev/md1 >/dev/null 2>&1 || true
step_ok

# ------------------------------------------------------------------------------
# Step 4: Install bootloader (GRUB) on new disk
# ------------------------------------------------------------------------------
step_start "[4/5] Bootloader GRUB (${TARGET_DEV})"
grub-install "$TARGET_DEV" >/dev/null 2>&1 || step_fail "grub-install failed on $TARGET_DEV!"
step_ok

# ------------------------------------------------------------------------------
# Step 5: Replace partition in ZFS pool and trigger Resilver
# ------------------------------------------------------------------------------
OLD_TARGET=$(python3 - << EOF
import os, subprocess, sys

pool_name = "$POOL_NAME"
clean_dev = "$CLEAN_DEV"
target_part = f"{clean_dev}4"

# Map all other physically present bays so hot-swap letter shifts (e.g. sdg -> sdi) are detected
bay_paths = [
    "pci-0000:00:1f.2-ata-1", "pci-0000:00:1f.2-ata-2",
    "pci-0000:00:1f.2-ata-3", "pci-0000:00:1f.2-ata-4",
    "pci-0000:00:1f.2-ata-5", "pci-0000:00:1f.2-ata-6",
    "pci-0000:01:00.0-ata-1", "pci-0000:01:00.0-ata-2",
]
other_bay_parts = set()
for p in bay_paths:
    lp = f"/dev/disk/by-path/{p}"
    if os.path.islink(lp):
        dev = os.path.basename(os.path.realpath(lp))
        if dev != clean_dev:
            other_bay_parts.add(f"{dev}4")

res = subprocess.run(['/sbin/zpool', 'status', pool_name], capture_output=True, text=True)
lines = res.stdout.splitlines()

# 1. Search for 'was /dev/target_part' or 'was target_part'
for line in lines:
    if f'was /dev/{target_part}' in line or f'was {target_part}' in line:
        print(line.strip().split()[0])
        sys.exit(0)

# 2. Search for any vdev (GUID or sdX4) that is UNAVAIL/FAULTED/OFFLINE/REMOVED
for line in lines:
    parts = line.strip().split()
    if len(parts) >= 2 and parts[1] in ['UNAVAIL', 'FAULTED', 'OFFLINE', 'REMOVED']:
        if parts[0].isdigit() or parts[0].startswith('sd'):
            print(parts[0])
            sys.exit(0)

# 3. Hot-swap shifted letter: find sdX4 in pool that no longer maps to any other physical bay
for line in lines:
    parts = line.strip().split()
    if len(parts) >= 2 and parts[0].startswith('sd') and parts[0] != target_part and parts[0] not in other_bay_parts:
        print(parts[0])
        sys.exit(0)

# 4. Fallback to target partition name itself
print(target_part)
EOF
)

step_start "[5/5] ZFS pool '${POOL_NAME}' (${OLD_TARGET} -> ${TARGET_DEV}4)"
ZFS_ERR=""
if ! ZFS_ERR=$(zpool replace -f "$POOL_NAME" "$OLD_TARGET" "${TARGET_DEV}4" 2>&1); then
    if [ "$OLD_TARGET" != "${CLEAN_DEV}4" ]; then
        zpool offline "$POOL_NAME" "$OLD_TARGET" >/dev/null 2>&1 || true
        ZFS_ERR=$(zpool replace -f "$POOL_NAME" "$OLD_TARGET" "${TARGET_DEV}4" 2>&1) || step_fail "ZFS replace failed: $ZFS_ERR"
    else
        step_fail "ZFS replace failed: $ZFS_ERR"
    fi
fi

zpool clear "$POOL_NAME" >/dev/null 2>&1 || true
step_ok

echo -e "\n${CYAN}==============================================================================${NC}"
echo -e "${GREEN}${BOLD}       PROCESS COMPLETED! DISK RE-INTEGRATED SUCCESSFULLY                       ${NC}"
echo -e "${CYAN}==============================================================================${NC}"
echo -e "Checking updated system status...\n"

status
