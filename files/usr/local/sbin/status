#!/usr/bin/env bash
# ==============================================================================
# TeraStation TS5800D - Disk Map and Health Diagnostics
# Read-only utility displaying real-time status of all 8 bays and storage stack
# ==============================================================================

set -o pipefail
export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:$PATH"

# Clear terminal screen if interactive
if [ -t 1 ]; then
    clear
fi

# ANSI Colors
RED='\033[1;31m'
GREEN='\033[1;32m'
YELLOW='\033[1;33m'
CYAN='\033[1;36m'
BOLD='\033[1m'
NC='\033[0m' # No Color

ARRAY_DEV="/dev/md2"

# Auto-detect number of physical ATA ports on chassis (2, 4, 6 or 8 bays)
TOTAL_BAYS=$(ls -d /sys/class/ata_port/ata* 2>/dev/null | wc -l)
if [ -z "$TOTAL_BAYS" ] || [ "$TOTAL_BAYS" -le 0 ]; then
    TOTAL_BAYS=8
fi

declare -A DISK_MAP
DISK_MAP["pci-0000:00:1f.2-ata-1"]="Bay 1"
DISK_MAP["pci-0000:00:1f.2-ata-2"]="Bay 2"
DISK_MAP["pci-0000:00:1f.2-ata-3"]="Bay 3"
DISK_MAP["pci-0000:00:1f.2-ata-4"]="Bay 4"
DISK_MAP["pci-0000:00:1f.2-ata-5"]="Bay 5"
DISK_MAP["pci-0000:00:1f.2-ata-6"]="Bay 6"
DISK_MAP["pci-0000:01:00.0-ata-1"]="Bay 7"
DISK_MAP["pci-0000:01:00.0-ata-2"]="Bay 8"

all_bays=(
    "pci-0000:00:1f.2-ata-1"
    "pci-0000:00:1f.2-ata-2"
    "pci-0000:00:1f.2-ata-3"
    "pci-0000:00:1f.2-ata-4"
    "pci-0000:00:1f.2-ata-5"
    "pci-0000:00:1f.2-ata-6"
    "pci-0000:01:00.0-ata-1"
    "pci-0000:01:00.0-ata-2"
)

# Dynamically slice bay list to match physical motherboard capacity
sorted_bays=("${all_bays[@]:0:$TOTAL_BAYS}")

echo -e "${BOLD}            TeraStation TS5800D - Disk Map and Health Diagnostics${NC}"
echo ""
echo -e "${CYAN}----------------------------------[ DISKS ]-----------------------------------${NC}"
printf "%-7s %-10s %-6s %-20s %-16s %s\n" "BAY" "DISK" "SIZE" "MODEL" "SERIAL" "STATUS"
echo -e "------------------------------------------------------------------------------"

mdstat_raw=$(cat /proc/mdstat 2>/dev/null || true)

REBUILD_CANDIDATE_DEV=""
REBUILD_CANDIDATE_DISK=""
REBUILDING_DEV=""
REBUILDING_DISK=""
REBUILDING_DISKS=()
OS_REBUILDING_DISKS=()
MD2_REBUILDING_DISKS=()
REBUILDING_COUNT=0
FAILED_COUNT=0
EMPTY_DISKS=()

read -r REBUILD_STAGE REBUILD_PCT <<< "$(python3 - << 'EOF'
import re

mdstat = ""
try:
    with open("/proc/mdstat", "r") as f:
        mdstat = f.read()
except Exception:
    pass

b0 = re.search(r'^md0\s*:.*?(?=\n\s*\n|\Z)', mdstat, re.MULTILINE | re.DOTALL)
b1 = re.search(r'^md1\s*:.*?(?=\n\s*\n|\Z)', mdstat, re.MULTILINE | re.DOTALL)
b2 = re.search(r'^md2\s*:.*?(?=\n\s*\n|\Z)', mdstat, re.MULTILINE | re.DOTALL)
m0 = re.search(r'(recovery|resync)\s*=\s*([0-9\.]+)%', b0.group(0)) if b0 else None
m1 = re.search(r'(recovery|resync)\s*=\s*([0-9\.]+)%', b1.group(0)) if b1 else None
m2 = re.search(r'(recovery|resync)\s*=\s*([0-9\.]+)%', b2.group(0)) if b2 else None

if m0:
    pct0 = float(m0.group(2))
    print(f"1 {pct0 * 0.862:.1f}%")
elif m1:
    pct1 = float(m1.group(2))
    print(f"1 {86.2 + (pct1 * 0.138):.1f}%")
elif m2:
    print(f"2 {float(m2.group(2)):.1f}%")
EOF
)"

if [ -z "$REBUILD_PCT" ]; then
    for md in md0 md1 md2; do
        if grep -q "^${md} : inactive" <<< "$mdstat_raw"; then
            continue
        fi
        if ls /sys/block/$md/md/dev-*/state 2>/dev/null | xargs grep -q "spare" 2>/dev/null; then
            REBUILD_PCT="syncing"
            break
        fi
    done
fi

for p in "${sorted_bays[@]}"; do
    disk_label="${DISK_MAP[$p]}"
    link_path="/dev/disk/by-path/$p"
    if [ -L "$link_path" ]; then
        dev_name=$(basename "$(readlink -f "$link_path")")
        dev_path="/dev/$dev_name"
        dev_part1="${dev_path}1"
        dev_part2="${dev_path}2"
        dev_part3="${dev_path}3"
        dev_part4="${dev_path}4"

        size=$(lsblk -d -n -o SIZE "$dev_path" 2>/dev/null | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' || true)
        size="${size:-N/A}"
        model=$(lsblk -d -n -o MODEL "$dev_path" 2>/dev/null || echo "N/A")
        serial=$(lsblk -d -n -o SERIAL "$dev_path" 2>/dev/null || echo "N/A")

        status_text="${GREEN}ONLINE${NC}"
        is_failed=0
        is_rebuilding=0
        is_os_rebuilding=0
        is_md2_rebuilding=0

        # Check if this disk is actively rebuilding in active md0, md1, or md2
        for md_part in "md0:${dev_name}2" "md1:${dev_name}3" "md2:${dev_name}4"; do
            md="${md_part%%:*}"
            part="${md_part#*:}"
            if grep -q "^${md} : inactive" <<< "$mdstat_raw"; then
                continue
            fi
            if [ -f "/sys/block/$md/md/dev-${part}/state" ]; then
                if grep -q "spare" "/sys/block/$md/md/dev-${part}/state" 2>/dev/null; then
                    is_rebuilding=1
                    if [ "$md" == "md2" ]; then
                        is_md2_rebuilding=1
                    else
                        is_os_rebuilding=1
                    fi
                fi
            fi
        done

        # Do not report REBUILD if md2 is dead/missing without active recovery (unless rebuild script is running)
        if [ ! -f "/run/terastation_rebuild_in_progress" ]; then
            if grep -q -E "\b${dev_name}4\[[0-9]+\]\(F\)" <<< "$mdstat_raw"; then
                is_rebuilding=0
                is_md2_rebuilding=0
            fi
        fi

        if [ "$is_rebuilding" -eq 1 ]; then
            status_text="${YELLOW}REBUILD${NC}"
            REBUILDING_COUNT=$((REBUILDING_COUNT + 1))
            REBUILDING_DISKS+=("$disk_label")
            [ "$is_os_rebuilding" -eq 1 ] && OS_REBUILDING_DISKS+=("$disk_label")
            [ "$is_md2_rebuilding" -eq 1 ] && MD2_REBUILDING_DISKS+=("$disk_label")
            if [ -z "$REBUILDING_DEV" ]; then
                REBUILDING_DEV="$dev_path"
                REBUILDING_DISK="$disk_label"
            fi
        else
            # 1. Check if disk has all 4 partitions
            if [ ! -b "$dev_part1" ] || [ ! -b "$dev_part2" ] || [ ! -b "$dev_part3" ] || [ ! -b "$dev_part4" ]; then
                status_text="${RED}FAILED${NC}"
                is_failed=1
            # 2. Check Debian RAID mirror health (md0 / md1) and RAID5 storage array (md2)
            elif ! grep -q -E "(^|[[:space:]])${dev_name}2\[[0-9]+\]([[:space:]]|$)" <<< "$mdstat_raw"; then
                status_text="${RED}FAILED${NC}"
                is_failed=1
            elif ! grep -q -E "(^|[[:space:]])${dev_name}3\[[0-9]+\]([[:space:]]|$)" <<< "$mdstat_raw"; then
                status_text="${RED}FAILED${NC}"
                is_failed=1
            elif ! grep -q -E "(^|[[:space:]])${dev_name}4\[[0-9]+\]([[:space:]]|$)" <<< "$mdstat_raw"; then
                status_text="${RED}FAILED${NC}"
                is_failed=1
            fi
        fi

        if [ "$is_failed" -eq 1 ]; then
            FAILED_COUNT=$((FAILED_COUNT + 1))
            if [ -z "$REBUILD_CANDIDATE_DEV" ]; then
                REBUILD_CANDIDATE_DEV="$dev_path"
                REBUILD_CANDIDATE_DISK="$disk_label"
            fi
        fi

        printf "%-7s %-10s %-6s %-20s %-16s " "$disk_label" "$dev_path" "$size" "${model:0:19}" "${serial:0:15}"
        echo -e "$status_text"
    else
        # Determine if this empty bay was part of an active array (real failure) or simply unpopulated
        is_missing_member=0
        if grep -qE '\[[U_]*_[U_]*\]' <<< "$mdstat_raw" || grep -q "^md2 : inactive" <<< "$mdstat_raw" || [ ! -b "$ARRAY_DEV" ]; then
            is_missing_member=1
        fi

        if [ "$is_missing_member" -eq 1 ]; then
            printf "%-7s %-10s %-6s %-20s %-16s ${RED}%s${NC}\n" "$disk_label" "[EMPTY]" "-" "-" "-" "NO DISK"
            EMPTY_DISKS+=("$disk_label")
            FAILED_COUNT=$((FAILED_COUNT + 1))
        else
            printf "%-7s %-10s %-6s %-20s %-16s ${CYAN}%s${NC}\n" "$disk_label" "[EMPTY]" "-" "-" "-" "UNPOPULATED"
        fi
    fi
done

echo -e "${CYAN}---------------------------------[ VOLUMES ]----------------------------------${NC}"
printf "%-7s %-10s %-6s %-20s %-16s %s\n" "TYPE" "DEVICE" "SIZE" "ARRAY" "INFO" "STATUS"
echo -e "------------------------------------------------------------------------------"

volumes_rows=$(python3 - << 'EOF'
import os, re

mdstat = ""
try:
    mdstat = open("/proc/mdstat").read()
except Exception:
    pass

def fmt_size(md):
    try:
        b = int(open(f"/sys/block/{md}/size").read().strip()) * 512
        if b >= 1024**4:
            return f"{b / (1024**4):.1f}T"
        if b >= 1024**3:
            return f"{b / (1024**3):.1f}G"
        return f"{b / (1024**2):.0f}M"
    except Exception:
        return "-"

specs = [
    ("md0", "OS", "RAID1", "Root (/)"),
    ("md1", "OS", "RAID1", "Swap"),
    ("md2", "ARRAY", "RAID5", "DATA"),
]

for md, vtype, level, info in specs:
    dev = f"/dev/{md}"
    m_blk = re.search(rf'(?ms)^{md}\s*:.*?(?=^\S|\Z)', mdstat)
    blk = m_blk.group(0) if m_blk else ""
    if not blk or "inactive" in blk:
        print(f"{vtype}|{dev}|-|{level} (-)|{info}|OFFLINE|RED")
        continue

    sz = fmt_size(md)
    md_dir = f"/sys/block/{md}/md"
    try:
        raid_disks = int(open(f"{md_dir}/raid_disks").read().strip())
        degraded = int(open(f"{md_dir}/degraded").read().strip())
        action = open(f"{md_dir}/sync_action").read().strip()
        active = max(0, raid_disks - degraded)
    except Exception:
        raid_disks, degraded, action, active = 0, 0, "idle", 0

    has_spare = any(
        "spare" in open(os.path.join(md_dir, d, "state")).read()
        for d in os.listdir(md_dir) if d.startswith("dev-")
    ) if os.path.exists(md_dir) else False

    if (md == "md2" and degraded >= 2) or active == 0:
        st, col = "FAILED", "RED"
    elif action in ("recover", "resync") or (degraded > 0 and has_spare):
        st, col = ("REBUILD" if action == "recover" or has_spare else action.upper()), "YELLOW"
    elif degraded > 0:
        st, col = "DEGRADED", "RED"
    elif action != "idle":
        st, col = action.upper(), "YELLOW"
    else:
        st, col = "ONLINE", "GREEN"

    arr_lbl = f"{level} ({active}/{raid_disks})"
    print(f"{vtype}|{dev}|{sz}|{arr_lbl}|{info}|{st}|{col}")
EOF
)

while IFS='|' read -r _vt _vd _vs _va _vi _vst _vcol; do
    [ -z "$_vt" ] && continue
    case "$_vcol" in
        GREEN)  _vc="$GREEN" ;;
        YELLOW) _vc="$YELLOW" ;;
        RED)    _vc="$RED" ;;
        *)      _vc="$NC" ;;
    esac
    printf "%-7s %-10s %-6s %-20s %-16s ${_vc}%s${NC}\n" "$_vt" "$_vd" "$_vs" "$_va" "$_vi" "$_vst"
done <<< "$volumes_rows"
echo -e "------------------------------------------------------------------------------"

md2_dead=0
if ! grep -q "^md2 :" <<< "$mdstat_raw" || grep -q "^md2 : inactive" <<< "$mdstat_raw"; then
    md2_dead=1
elif [ -f /sys/block/md2/md/degraded ] && [ "$(cat /sys/block/md2/md/degraded 2>/dev/null)" -ge 2 ]; then
    md2_dead=1
fi
md2_action=$(cat /sys/block/md2/md/sync_action 2>/dev/null || true)
os_rebuilding=0
for _os_md in md0 md1; do
    _os_act=$(cat "/sys/block/${_os_md}/md/sync_action" 2>/dev/null || true)
    if [ "$_os_act" == "recover" ] || [ "$_os_act" == "resync" ] || \
       ls /sys/block/${_os_md}/md/dev-*/state 2>/dev/null | xargs grep -q "spare" 2>/dev/null; then
        os_rebuilding=1
        break
    fi
done

if [ "$FAILED_COUNT" -ge 2 ] || [ "$md2_dead" -eq 1 ]; then
    echo -e "${RED}${BOLD}STATUS: Critical failure on 2+ disks. RAID-5 ($ARRAY_DEV) unrecoverable.${NC}"
    echo -e "${RED}${BOLD}        After replacing disks, run: rebuild --init-storage${NC}"
elif [ -n "$REBUILD_CANDIDATE_DEV" ]; then
    disk_num="${REBUILD_CANDIDATE_DISK#Bay }"
    echo -e "${RED}${BOLD}STATUS: Disk failure on $REBUILD_CANDIDATE_DISK. Run: rebuild $disk_num${NC}"
elif [ ${#EMPTY_DISKS[@]} -gt 0 ]; then
    echo -e "${YELLOW}${BOLD}STATUS: No disk in ${EMPTY_DISKS[*]}. Insert replacement disk to proceed.${NC}"
elif [ "$REBUILDING_COUNT" -gt 0 ]; then
    pct_info=" (syncing)"
    if [ -n "$REBUILD_PCT" ]; then
        pct_info=" (${REBUILD_PCT})"
    fi
    rebuilding_list=$(printf "%s, " "${REBUILDING_DISKS[@]}")
    rebuilding_list="${rebuilding_list%, }"
    if [ "$REBUILD_STAGE" == "1" ]; then
        if [ ${#OS_REBUILDING_DISKS[@]} -gt 0 ]; then
            stage_disks=$(printf "%s, " "${OS_REBUILDING_DISKS[@]}")
            stage_disks="${stage_disks%, }"
        else
            stage_disks="$rebuilding_list"
        fi
        echo -e "${YELLOW}${BOLD}STATUS: Stage 1/2 - Rebuilding OS mirrors (md0/md1) on ${stage_disks}${pct_info}.${NC}"
    elif [ "$REBUILD_STAGE" == "2" ]; then
        if [ ${#MD2_REBUILDING_DISKS[@]} -gt 0 ]; then
            stage_disks=$(printf "%s, " "${MD2_REBUILDING_DISKS[@]}")
            stage_disks="${stage_disks%, }"
        else
            stage_disks="$rebuilding_list"
        fi
        echo -e "${YELLOW}${BOLD}STATUS: Stage 2/2 - Rebuilding RAID-5 ($ARRAY_DEV) on ${stage_disks}${pct_info}.${NC}"
    elif [ "$os_rebuilding" -eq 1 ]; then
        echo -e "${YELLOW}${BOLD}STATUS: Stage 1/2 - Rebuilding OS mirrors (md0/md1) on ${rebuilding_list}${pct_info}.${NC}"
    else
        echo -e "${YELLOW}${BOLD}STATUS: Stage 2/2 - Rebuilding RAID-5 ($ARRAY_DEV) on ${rebuilding_list}${pct_info}.${NC}"
    fi
elif [ "$md2_action" == "resync" ] || [ "$md2_action" == "check" ]; then
    pct_info=" (syncing)"
    if [ -n "$REBUILD_PCT" ]; then
        pct_info=" (${REBUILD_PCT})"
    fi
    echo -e "${YELLOW}${BOLD}STATUS: Array ${md2_action} in progress on $ARRAY_DEV${pct_info}.${NC}"
else
    echo -e "${GREEN}${BOLD}STATUS: All 8 disks are 100% healthy and synchronized across md0, md1, and md2.${NC}"
fi
echo -e "To replace a failed disk or view recovery options, run: ${GREEN}rebuild${NC}"
