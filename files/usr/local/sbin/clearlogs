#!/usr/bin/env bash
# ==============================================================================
# TeraStation TS5800D - Log Cleanup Utility
# Safely clears systemd journal, kernel ring buffer, and /var/log text files.
# ==============================================================================

set -euo pipefail
export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:$PATH"

RED='\033[1;31m'
GREEN='\033[1;32m'
CYAN='\033[1;36m'
BOLD='\033[1m'
NC='\033[0m'

# Auto-elevate to sudo if executed as standard user
if [ "$(id -u)" -ne 0 ]; then
    exec sudo "$0" "$@"
fi

run_step() {
    local msg="$1"
    shift
    local pad=$((69 - ${#msg}))
    [ "$pad" -lt 3 ] && pad=3
    local dots
    dots=$(printf '%*s' "$pad" '' | tr ' ' '.')

    printf "%s %s " "$msg" "$dots"
    if "$@" >/dev/null 2>&1; then
        echo -e "[ ${GREEN}OK${NC} ]"
    else
        echo -e "[${RED}FAIL${NC}]"
        return 1
    fi
}

clear_journal() {
    journalctl --rotate
    journalctl --vacuum-time=1s
}

clear_varlog() {
    find /var/log -type f \( -name "*.gz" -o -name "*.[0-9]" \) -delete
    find /var/log -type f -name "*.log" -exec truncate -s 0 {} +
}

if [ -t 1 ]; then
    clear
fi

echo -e "${BOLD}                  TeraStation TS5800D - System Log Cleanup${NC}"
echo ""
echo -e "${CYAN}---------------------------------[ CLEANUP ]----------------------------------${NC}"

run_step "[1/3] Systemd journal (rotate & vacuum)" clear_journal
run_step "[2/3] Kernel ring buffer (dmesg)" dmesg -C
run_step "[3/3] Rotated archives and active .log files" clear_varlog

echo "------------------------------------------------------------------------------"
echo -e "${GREEN}STATUS: All logs cleared safely.${NC}"
echo "------------------------------------------------------------------------------"
