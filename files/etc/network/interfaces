# This file describes the network interfaces available on your system
# and how to activate them. For more information, see interfaces(5).

source /etc/network/interfaces.d/*

# The loopback network interface
auto lo
iface lo inet loopback

# Physical NICs as bond slaves (no standalone IP)
iface enp3s0 inet manual
    up /sbin/ip link set dev $IFACE mtu 9000
iface enp4s0 inet manual
    up /sbin/ip link set dev $IFACE mtu 9000

# Aggregated bond0 interface with DHCP and Jumbo Frames (MTU 9000)
auto bond0
iface bond0 inet dhcp
    bond-slaves enp3s0 enp4s0
    bond-mode balance-alb
    bond-miimon 100
    bond-downdelay 200
    bond-updelay 200
    post-up /sbin/ip link set dev $IFACE mtu 9000
