[Unit]
Description=Terastation LCD Status and RAID Health Monitor
After=micon_boot.service local-fs.target
Wants=micon_boot.service

[Service]
Type=simple
User=root
ExecStart=/usr/bin/python3 /usr/local/bin/micon_scripts/micon_lcd_monitor.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
